{
  "name": "0xword",
  "displayName": "0xWORD",
  "description": "Guess 8 hex digits that make a real 4-letter word, then decode it. In your side bar while your agent works.",
  "version": "0.0.1",
  "publisher": "dconyemerekwe",
  "license": "MIT",
  "icon": "media/icon.png",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dconyemerekwe/0xword.git"
  },
  "homepage": "https://github.com/dconyemerekwe/0xword#readme",
  "bugs": {
    "url": "https://github.com/dconyemerekwe/0xword/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hex",
    "hexadecimal",
    "ascii",
    "word game",
    "word",
    "game",
    "puzzle"
  ],
  "galleryBanner": {
    "color": "#14161B",
    "theme": "dark"
  },
  "activationEvents": [
    "onUri"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "0xword.newRound",
        "title": "New Round",
        "category": "0xWORD"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "0xword",
          "title": "0xWORD",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "0xword": [
        {
          "type": "webview",
          "id": "0xword.game",
          "name": "0xWORD"
        }
      ]
    },
    "configuration": {
      "title": "0xWORD",
      "properties": {
        "0xword.autoStart.mode": {
          "type": "string",
          "enum": [
            "off",
            "notify"
          ],
          "enumDescriptions": [
            "Show nothing when your agent starts working. Your agent hooks can stay set up.",
            "Show the notices switched on below while your agent works, and remove them when it finishes."
          ],
          "default": "off",
          "scope": "window",
          "order": 0,
          "markdownDescription": "What 0xWORD does when your agent starts working. Notices are `off` by default, so nothing shows. Choose `notify` to turn them on."
        },
        "0xword.notify.badge": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 1,
          "markdownDescription": "In `notify` mode, show a badge on the 0xWORD icon in the activity bar while your agent works. It shows once you've opened the 0xWORD panel at least once."
        },
        "0xword.notify.statusBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 2,
          "markdownDescription": "In `notify` mode, show `0x Round ready` in the status bar while your agent works. Click it to open the panel."
        },
        "0xword.notify.popup": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "order": 3,
          "markdownDescription": "In `notify` mode, show a notification with **Play** and **Not now** when your agent starts working. It doesn't take focus."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p media",
    "test": "node --test \"test/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && npm run build",
    "package": "vsce package --no-dependencies --githubBranch main",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
