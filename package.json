{
  "name": "0xword",
  "displayName": "0xWORD",
  "description": "Decode a hidden 4-letter word from its ASCII hex while your AI agent works.",
  "version": "0.0.1",
  "publisher": "dconyemerekwe",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dconyemerekwe/0xword.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --loader:.txt=text --sourcemap --outfile=dist/extension.cjs",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
